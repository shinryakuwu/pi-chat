<h1>Sign In</h1>

<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<%= form_with url: session_path do |form| %>
  <%= form.text_field :username, required: true, autofocus: true, placeholder: "Enter your username" %><br>
  <%= form.password_field :password, required: true, placeholder: "Enter your password" %><br>
  <%= form.submit "Sign in" %>
<% end %>
<br>
<p>
  Don't have an account?
  <%= link_to "Sign up", new_user_path %>.
</p>
