<turbo-frame id="chat">
  <%= turbo_stream_from [@chat, @user] %>
  <%= link_to "←",
      root_path,
      data: { turbo_frame: "chat", action: "click->sidebar#clear click->window#showNavigation" },
      id: "back_to_navigation" %>
  <div id="chat_container" data-controller="messages">
    <div id="chat_content">
      <% @messages&.each do |message| %>
        <%= render "messages/message", message: message, user: @user %>
      <% end %>
    </div>
  </div>
  <%= render "chats/input_panel", message_url: user_messages_path(@receiver) %>
</turbo-frame>
