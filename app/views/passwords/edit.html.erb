<h1>Update your password</h1>

<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<%= form_with url: password_path(), method: :put do |form| %>
  <%= form.password_field :old_password, required: true, placeholder: "Enter your current password", maxlength: 72 %><br>
  <%= form.password_field :password, required: true, placeholder: "Enter new password", maxlength: 72 %><br>
  <%= form.password_field :password_confirmation, required: true, placeholder: "Repeat new password", maxlength: 72 %><br>
  <%= form.submit "Save" %>
<% end %>
