<turbo-frame id="chat">
  <%= link_to "←",
      chats_path,
      data: { turbo_frame: "chat", action: "click->sidebar#clear" },
      id: "back_to_navigation" %>
  <div id="chat_container">
    <div id="chat_content">
    </div>
  </div>
  <%= render "chats/input_panel", message_url: user_messages_path(@receiver) %>
</turbo-frame>
