<div id="auth_screen">
  <div id="auth_box">
    <%= form_with url: session_path, class: "auth_form", id: "sign_in_form" do |form| %>
      <div class="auth_header">Sign In</div>
      <%= tag.div(flash[:alert], class: "alert") if flash[:alert] %>
      <%= tag.div(flash[:notice], class: "notice") if flash[:notice] %>
      <%= form.text_field :username, required: true, autofocus: true, placeholder: "Username", id: "username_input" %>
      <%= form.password_field :password, required: true, placeholder: "Password", id: "password_input" %>
      <%= form.submit "Sign in", class: "submit" %>
      <div class="auth_toggle_block">
        Don't have an account?
        <%= link_to "Sign up", new_user_path, class: "auth_switch" %>.
      </div>
    <% end %>
  </div>
</div>
